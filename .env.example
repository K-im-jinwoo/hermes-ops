# Hermes LLM Provider Configuration
HERMES_MODEL_PROVIDER="openrouter"
HERMES_MODEL_NAME="nousresearch/hermes-3-llama-3.1-405b"
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Telegram Bot Gateway Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Production may provide the token through this file instead of an environment value.
TELEGRAM_BOT_TOKEN_FILE=""
TELEGRAM_ALLOWED_USER_IDS="123456789"
# Set true only during an approved Telegram cutover.
TELEGRAM_DELETE_WEBHOOK="false"
HERMES_APPROVAL_DB_PATH="./data/memo_approvals.sqlite3"
HERMES_APPROVAL_TTL_SECONDS="300"
HERMES_MEMO_SINK="direct"
HERMES_INBOX_QUEUE_DIR="./data/inbox_queue"
HERMES_METRICS_LOG="./logs/events.jsonl"

# Google Drive REST CRUD (runtime-only OAuth JSON, never commit this file)
GOOGLE_DRIVE_CREDENTIALS_FILE="/run/secrets/google-drive-credentials"
GOOGLE_DRIVE_ROOT_ID=""
GOOGLE_DRIVE_CREDENTIALS_HOST_FILE="/srv/hermes-ops/google-drive-credentials.json"

# Internal Services Endpoints (Tools)
WIKI_API_URL="http://localhost:8000/api/wiki"
WIKI_API_KEY=""

HARNESS_API_URL="http://localhost:8080/api/harness"
